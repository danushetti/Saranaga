# App
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Razorpay: use Test Mode keys while developing.
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_WITH_TEST_KEY_SECRET

# Firebase Admin service account JSON (one-line JSON).
# Firebase Auth is optional for guest checkout, but required to verify Google sign-in tokens.
# In production, prefer a secret manager rather than committing this value to a file.
FIREBASE_SERVICE_ACCOUNT_JSON=
